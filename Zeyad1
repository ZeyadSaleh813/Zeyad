   qs:[
    ["ما المشكلة في هذا الترتيب بالنسبة للنشاط؟",["يزيد التواصل بين الطلبة","يحدّ من التواصل ويجعل الاتجاه غالبًا من المعلم إلى الطلبة","يوفر مساحة كبيرة","يمنع الضوضاء تمامًا"],1,"الصفوف المتتالية تقلل التفاعل بين الطلبة، وهذا لا يناسب التعلم التعاوني."],
