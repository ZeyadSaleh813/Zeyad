   qs:[
    ["أي عنصر في البيئة تأثر هنا؟",["الإضاءة","المناخ النفسي-الاجتماعي (الأمان والاحترام)","عدد المقاعد","الكتاب المدرسي"],1,"السخرية تهدم الشعور بالأمان والاحترام، وهما أساس المناخ النفسي-الاجتماعي."],
