<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>بيئة التعلم ومصادره: اختيار من متعدد</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#f2f5f9; --surface:#ffffff; --ink:#14213d; --muted:#5a6679; --line:#d5dde8;
  --accent:#0f7c7e; --accent-ink:#ffffff; --accent-soft:#dff1f1; --warm:#e9b44c;
  --ok:#1f7a4d; --ok-soft:#dff3e8; --bad:#a63a2e; --bad-soft:#fbe4e0;
  color-scheme: light;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0f1624; --surface:#18233a; --ink:#e8edf6; --muted:#9aa8bf; --line:#2c3a56;
    --accent:#3cc3c5; --accent-ink:#06282a; --accent-soft:#16363f; --warm:#e9b44c;
    --ok:#6fd6a1; --ok-soft:#173a2b; --bad:#f19a8e; --bad-soft:#431f1b;
    color-scheme: dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0f1624; --surface:#18233a; --ink:#e8edf6; --muted:#9aa8bf; --line:#2c3a56;
  --accent:#3cc3c5; --accent-ink:#06282a; --accent-soft:#16363f; --warm:#e9b44c;
  --ok:#6fd6a1; --ok-soft:#173a2b; --bad:#f19a8e; --bad-soft:#431f1b;
  color-scheme: dark;
}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);
  font-family:"IBM Plex Sans Arabic",Tahoma,"Segoe UI",sans-serif;line-height:1.85;font-size:17px}
main{max-width:760px;margin:0 auto;padding:28px 18px 60px}
h1{font-size:1.7rem;line-height:1.4;margin:0 0 6px;font-weight:700}
.lead{color:var(--muted);margin:0 0 26px}
.group{margin-bottom:22px}
.group-title{font-weight:700;margin-bottom:8px}
.levels{display:flex;gap:8px;flex-wrap:wrap}
.chip{border:1.5px solid var(--line);background:var(--surface);color:var(--ink);
  padding:8px 16px;border-radius:999px;font:inherit;cursor:pointer}
.chip[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--accent-ink);font-weight:500}
.topics{list-style:none;margin:0;padding:0;border:1.5px solid var(--line);border-radius:12px;overflow:hidden;background:var(--surface)}
.topics li+li{border-top:1px solid var(--line)}
.topic{width:100%;display:flex;align-items:center;gap:12px;text-align:right;
  background:none;border:0;color:var(--ink);font:inherit;padding:12px 14px;cursor:pointer}
.topic:hover{background:var(--accent-soft)}
.num{flex:none;width:30px;height:30px;border-radius:50%;display:grid;place-items:center;
  background:var(--accent-soft);color:var(--accent);font-weight:700;font-size:.95rem}
.topic[aria-current="true"] .num{background:var(--accent);color:var(--accent-ink)}
.topic .t{flex:1}
.done{font-size:.85rem;color:var(--ok);background:var(--ok-soft);padding:2px 10px;border-radius:999px}
.stage{background:var(--surface);border:1.5px solid var(--line);border-radius:14px;padding:20px 18px;margin-top:8px}
.stage h2{font-size:1.25rem;margin:0 0 10px}
.scenario{border-right:4px solid var(--warm);padding:4px 14px;margin:0 0 16px;background:var(--bg);border-radius:6px}
.progress{height:6px;background:var(--line);border-radius:6px;overflow:hidden;margin-bottom:6px}
.progress>i{display:block;height:100%;background:var(--accent);width:0;transition:width .3s}
.count{color:var(--muted);font-size:.9rem;margin-bottom:12px}
.q{font-weight:700;margin:0 0 12px;font-size:1.08rem}
.opts{display:flex;flex-direction:column;gap:9px}
.opt{display:flex;align-items:flex-start;gap:12px;text-align:right;width:100%;
  font:inherit;color:var(--ink);background:var(--bg);border:1.5px solid var(--line);
  border-radius:12px;padding:10px 12px;cursor:pointer}
.opt:hover:not([disabled]){border-color:var(--accent)}
.opt[disabled]{cursor:default}
.circle{flex:none;width:30px;height:30px;border-radius:50%;border:2px solid var(--muted);
  display:grid;place-items:center;font-size:.9rem;font-weight:500;color:var(--muted);margin-top:1px}
.opt .txt{flex:1}
.opt.correct{border-color:var(--ok);background:var(--ok-soft)}
.opt.correct .circle{background:var(--ok);border-color:var(--ok);color:var(--surface)}
.opt.wrong{border-color:var(--bad);background:var(--bad-soft)}
.opt.wrong .circle{background:var(--bad);border-color:var(--bad);color:var(--surface)}
.fb{margin-top:14px;padding:10px 14px;border-radius:10px;background:var(--accent-soft)}
.fb b{display:block;margin-bottom:2px}
.fb.ok b{color:var(--ok)} .fb.bad b{color:var(--bad)}
.btn{font:inherit;border:0;border-radius:10px;padding:9px 18px;cursor:pointer;background:var(--accent);color:var(--accent-ink);font-weight:500;margin-top:14px}
.btn.ghost{background:transparent;color:var(--ink);border:1.5px solid var(--line)}
textarea:focus-visible,.chip:focus-visible,.topic:focus-visible,.btn:focus-visible,.opt:focus-visible{outline:3px solid var(--warm);outline-offset:2px}
.summary{text-align:center;padding:6px 0}
.summary .score{font-size:2.2rem;font-weight:700;color:var(--accent)}
.review{text-align:right;margin:14px 0;padding:0;list-style:none}
.review li{padding:10px 12px;border:1px solid var(--line);border-radius:10px;margin-bottom:8px;background:var(--bg)}
.review small{display:block;color:var(--ok)}
.empty{color:var(--muted);padding:18px;text-align:center}
.top{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
.theme{background:none;border:1.5px solid var(--line);color:var(--ink);border-radius:10px;padding:4px 10px;font:inherit;cursor:pointer}
@media (prefers-reduced-motion: reduce){.progress>i{transition:none}}
</style>
</head>
<body>
<main>
  <div class="top">
    <div>
      <h1>بيئة التعلم ومصادره: اختيار من متعدد</h1>
      <p class="lead">اختر مستوى وموضوعًا، ثم ضع دائرة حول رمز الإجابة الصحيحة. تظهر النتيجة والتفسير فور اختيارك.</p>
    </div>
    <button class="theme" id="themeBtn" type="button" aria-label="تبديل المظهر">◐</button>
  </div>

  <div class="group">
    <div class="group-title">المستوى</div>
    <div class="levels" id="levels"></div>
  </div>

  <div class="group">
    <div class="group-title">الموضوع (الترتيب المقترح 1 ← 7)</div>
    <ul class="topics" id="topics"></ul>
  </div>

  <section id="stage" aria-live="polite"></section>
</main>

<script>
/* ===== بيانات المحتوى =====
   كل سؤال: [نص السؤال, [البدائل], رقم الإجابة الصحيحة (يبدأ من 0), التفسير] */
const LEVELS = [
  {id:"a", name:"التذكّر والفهم"},
  {id:"b", name:"التطبيق والتحليل"}
];

const TOPICS = [
 {title:"مفهوم بيئة التعلم وأنواعها", items:{
  a:{scenario:"تدخل معلمة صفًا فيه 30 طالبًا وتريد أن تفهم ما المقصود ببيئة التعلم قبل تخطيط درسها.",
   qs:[
    ["ما المقصود ببيئة التعلم؟",["الكتاب المدرسي والمنهاج فقط","المحيط الكلي المادي والنفسي-الاجتماعي والتقني الذي يجري فيه التعلم","مبنى المدرسة وساحاتها","الأنشطة التي يخطط لها المعلم"],1,"بيئة التعلم هي المحيط الكلي الذي يجري فيه التعلم ويؤثر في الطلبة، ولا تقتصر على المبنى أو المنهاج."],
    ["أي مما يلي يُعد من أنواع بيئة التعلم؟",["البيئة المادية والبيئة النفسية-الاجتماعية","بيئة الامتحانات وبيئة الواجبات","البيئة الورقية والبيئة الشفوية فقط","بيئة المعلم وبيئة المدير"],0,"التصنيف المعتمد: مادية ونفسية-اجتماعية، ويضاف إليهما الرقمية عند التعلم عبر المنصات."],
    ["أي الأمثلة التالية يمثل بيئة نفسية-اجتماعية؟",["ترتيب المقاعد","إضاءة الصف","مناخ الاحترام وتشجيع المشاركة","حجم السبورة"],2,"المناخ والعلاقات والدعم من عناصر البيئة النفسية-الاجتماعية، أما البقية فمادية."]
   ]},
  b:{scenario:"ينقل معلم درسه إلى منصة إلكترونية لمدة أسبوعين بسبب ظرف طارئ.",
   qs:[
    ["ما نوع بيئة التعلم الجديدة؟",["بيئة مادية تقليدية","بيئة رقمية افتراضية","بيئة مجتمعية","بيئة مخبرية"],1,"التعلم عبر المنصة يجري في بيئة رقمية (افتراضية) تعتمد على الاتصال والمنصة."],
    ["أي عنصر يبقى مؤثرًا في التعلم حتى في هذه البيئة؟",["لا شيء، لأن التعلم أصبح إلكترونيًا","مكان دراسة الطالب وهدوؤه ومناخ التفاعل مع المعلم","السبورة فقط","ترتيب مقاعد الصف الأصلي"],1,"ظروف مكان الدراسة (مادية) ومناخ التفاعل (نفسي-اجتماعي) يؤثران في الانتباه والدافعية."],
    ["أنسب إجراء للحفاظ على مناخ داعم عن بُعد هو:",["الاكتفاء بالمحاضرة المسجلة","منع الأسئلة لتوفير الوقت","قواعد مشاركة واضحة وقنوات للأسئلة وتغذية راجعة سريعة","إلغاء الأنشطة الجماعية"],2,"الوضوح والتواصل والتغذية الراجعة تبني الأمان والتفاعل حتى عن بُعد."]
   ]}
 }},
 {title:"البيئة المادية", items:{
