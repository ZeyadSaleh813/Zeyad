/* ===== نهاية البيانات ===== */

const LETTERS=["أ","ب","ج","د","هـ"];
const LS="lenv-mcq-progress-v1";
let state={level:"a",topic:0,idx:0,picked:null,results:[],open:false};
let progress={};
try{progress=JSON.parse(localStorage.getItem(LS)||"{}")}catch(e){progress={}}
function save(){try{localStorage.setItem(LS,JSON.stringify(progress))}catch(e){}}

const $=s=>document.querySelector(s);
const levelsEl=$("#levels"), topicsEl=$("#topics"), stageEl=$("#stage");

function resetTopic(){state.idx=0;state.picked=null;state.results=[]}

function renderLevels(){
  levelsEl.innerHTML="";
  LEVELS.forEach(l=>{
    const b=document.createElement("button");
    b.className="chip";b.type="button";b.textContent=l.name;
    b.setAttribute("aria-pressed",String(state.level===l.id));
    b.onclick=()=>{state.level=l.id;resetTopic();renderAll()};
    levelsEl.appendChild(b);
  });
}
function renderTopics(){
  topicsEl.innerHTML="";
  TOPICS.forEach((t,i)=>{
    const li=document.createElement("li");
    const b=document.createElement("button");
    b.className="topic";b.type="button";
    if(state.open&&state.topic===i)b.setAttribute("aria-current","true");
    const p=progress[state.level+"-"+i];
    b.innerHTML='<span class="num">'+(i+1)+'</span><span class="t">'+t.title+'</span>'+(p?'<span class="done">'+p.score+'/'+p.total+'</span>':'');
    b.onclick=()=>{state.topic=i;state.open=true;resetTopic();renderAll();stageEl.scrollIntoView({behavior:"smooth",block:"start"})};
    li.appendChild(b);topicsEl.appendChild(li);
  });
}

function renderStage(){
  if(!state.open){stageEl.innerHTML='<div class="empty">اختر موضوعًا من القائمة للبدء.</div>';return}
  const t=TOPICS[state.topic], item=t.items[state.level], n=item.qs.length;
  let h='<div class="stage"><h2>'+t.title+'</h2>';

  if(state.idx>=n){
    const sc=state.results.filter(r=>r.ok).length;
    h+='<div class="summary"><div class="score">'+sc+' / '+n+'</div><p>أنهيت هذا الموضوع.</p></div>';
    const wrong=state.results.filter(r=>!r.ok);
    if(wrong.length){
      h+='<p><b>أسئلة تحتاج إلى مراجعة:</b></p><ul class="review">';
      wrong.forEach(r=>{const q=item.qs[r.i];h+='<li>'+q[0]+'<small>الإجابة الصحيحة: '+LETTERS[q[2]]+') '+q[1][q[2]]+'</small></li>'});
      h+='</ul>';
    }
    h+='<div style="text-align:center"><button class="btn ghost" id="again" type="button">أعد المحاولة</button> ';
    if(state.topic<TOPICS.length-1)h+='<button class="btn" id="next" type="button">الموضوع التالي</button>';
    h+='</div></div>';
    stageEl.innerHTML=h;
    $("#again").onclick=()=>{resetTopic();renderStage()};
    const nx=$("#next"); if(nx)nx.onclick=()=>{state.topic++;resetTopic();renderAll();stageEl.scrollIntoView({behavior:"smooth",block:"start"})};
    return;
  }

  const [q,opts,c,e]=item.qs[state.idx];
  const answered=state.picked!==null;
  h+='<div class="scenario">'+item.scenario+'</div>';
  h+='<div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="'+n+'" aria-valuenow="'+state.idx+'"><i style="width:'+(state.idx/n*100)+'%"></i></div>';
  h+='<div class="count">السؤال '+(state.idx+1)+' من '+n+'</div>';
  h+='<p class="q">'+q+'</p><div class="opts" role="radiogroup" aria-label="البدائل">';
  opts.forEach((o,i)=>{
    let cls="opt";
    if(answered){if(i===c)cls+=" correct";else if(i===state.picked)cls+=" wrong"}
    h+='<button type="button" role="radio" aria-checked="'+(state.picked===i)+'" class="'+cls+'" data-i="'+i+'"'+(answered?' disabled':'')+'><span class="circle">'+LETTERS[i]+'</span><span class="txt">'+o+'</span></button>';
  });
  h+='</div>';
  if(answered){
    const ok=state.picked===c;
    h+='<div class="fb '+(ok?'ok':'bad')+'"><b>'+(ok?'إجابة صحيحة':'إجابة غير صحيحة، الصحيحة: '+LETTERS[c])+'</b>'+e+'</div>';
    h+='<button class="btn" id="go" type="button">'+(state.idx===n-1?'عرض النتيجة':'السؤال التالي')+'</button>';
  }
  h+='</div>';
  stageEl.innerHTML=h;

  stageEl.querySelectorAll(".opt").forEach(b=>b.onclick=()=>{
    state.picked=+b.dataset.i;
    state.results.push({i:state.idx,ok:state.picked===c});
    renderStage();
  });
  const go=$("#go");
  if(go)go.onclick=()=>{
    state.idx++;state.picked=null;
    if(state.idx>=n){
      progress[state.level+"-"+state.topic]={score:state.results.filter(r=>r.ok).length,total:n};
      save();renderTopics();
    }
    renderStage();
  };
}
function renderAll(){renderLevels();renderTopics();renderStage()}
renderAll();

$("#themeBtn").onclick=()=>{
  const r=document.documentElement;
  const dark=r.getAttribute("data-theme")==="dark"||(!r.getAttribute("data-theme")&&matchMedia("(prefers-color-scheme: dark)").matches);
  r.setAttribute("data-theme",dark?"light":"dark");
};
</script>
